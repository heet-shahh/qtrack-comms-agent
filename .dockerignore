# node_modules is a symlink to prebaked deps inside the microVM — never send it
# (or other scratch) into the publish build context.
**/node_modules
**/__pycache__
**/*.py[cod]
**/dist
.git
.rr
.env
.venv
# POC: bake the Retell key into the image so it runs with no runtime -e.
# (Key lives in image layers — do not push this image to a public registry.)
!backend/.env
